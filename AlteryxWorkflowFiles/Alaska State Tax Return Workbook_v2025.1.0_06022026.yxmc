                      <Mode>Custom</Mode>
                    </Configuration>
                    <Annotation DisplayMode="0">
                      <Name />
                      <DefaultAnnotationText><![CDATA[[xRef Amount Field ID] = "X72.8.33" OR
[xRef Amount Field ID] = "X72.8.13"

]]></DefaultAnnotationText>
                      <Left value="False" />
                    </Annotation>
                    <MetaInfo connection="True">
                      <RecordInfo>
                        <Field description="Keep" name="xRef Amount Field ID" size="1073741823" source="Summarize: GroupBy - xRef Amount Field ID" type="V_WString" />
                        <Field description="Keep" name="Value" size="1073741823" source="Formula: /*&#xA;EDA: 04/24/2025 | built Key-Value Pair logic into mapping file to replace original formula below. Leaving original formula, just in case we need to revert.&#xA; &#xA;Original formula:&#xA;IIF([GoRS Data Format] = &quot;Checkbox&quot;, IIF([Export Value] = &quot;Export value = X&quot;, IIF(IsEmpty([Value]) OR [Value] = &quot;No&quot; OR [Value] = &quot;False&quot;, Null(), &quot;X&quot;), IIF([Value]=&quot;True&quot;, &quot;X&quot;, Null())), IIF([Value]=&quot;0&quot;, Null(), [Value]))&#xA;*/&#xA; &#xA;IIF(Contains([GoRS Data Format], &quot;Dollar&quot;),&#xA; &#xA;/*IIF #1: True Condition*/&#xA;IIF(Contains([GoRS Data Format], &quot;NONE&quot;),&#xA; &#xA;/*IIF #2: True Condition*/&#xA;IIF([Value] = &quot;0&quot;,&#xA; &#xA;/*IIF #3: True Condition*/&#xA;&quot;NONE&quot;,&#xA; &#xA;/*IIF #3: False Condition*/&#xA;[Value]),&#xA; &#xA;/*IIF #2: False Condition*/&#xA;[Value]),&#xA; &#xA;/*IIF #1: False Condition*/&#xA;IIF(Contains([GoRS Data Format], &quot;Percentage&quot;),&#xA; &#xA;IIF(IsEmpty([Value]), Null(),&#xA; &#xA;/*IIF #4: True Condition*/&#xA;IIF(Contains([GoRS Data Format], &quot;NONE&quot;),&#xA; &#xA;/*IIF #5: True Condition*/&#xA;IIF(ToString(ToNumber([Value]), ToNumber([GoRS Decimal Precision]))=ToString(ToNumber(&quot;0.000000&quot;), ToNumber([GoRS Decimal Precision])),&#xA; &#xA;/*IIF #6: True Condition*/&#xA;&quot;NONE&quot;,&#xA; &#xA;/*IIF #6: False Condition*/&#xA;ToString(ToNumber([Value]), ToNumber([GoRS Decimal Precision]))),&#xA; &#xA;/*IIF #5: False Condition*/&#xA;ToString(ToNumber([Value]), ToNumber([GoRS Decimal Precision])))),&#xA; &#xA;/*IIF #4: False Condition*/&#xA;IIF([GoRS Data Format] = &quot;MM/DD/YYYY&quot;,&#xA; &#xA;/*IIF #7: True Condition*/&#xA;DateTimeFormat(DateTimeParse([Value],&quot;%m/%d/%Y&quot;), &quot;%m/%d/%Y&quot;),&#xA; &#xA;/*IIF #7: False Condition*/&#xA;IIF(!IsEmpty([Max Length (Text Fields)]),&#xA; &#xA;/*IIF #8: True Condition*/&#xA;Left([Value], [Max Length (Text Fields)]),&#xA; &#xA;/*IIF #8: False Condition*/&#xA;[Value]))))" type="V_WString" />
                        <Field name="Level" type="Int32" />
                        <Field description="Keep" name="Index" source="Formula: (Multiple Sources)" type="Double" />
                        <Field description="Keep" name="GroupSetId*" source="Formula: (Multiple Sources)" type="Double" />
                        <Field description="Keep" name="Consolidated Sort Order" size="1073741823" source="Formula: IIF(IsEmpty([Group Field ID 1]), [Consolidated Sort Order], ToString([RecordID]) + &quot;.&quot; + [Consolidated Sort Order])" type="V_WString" />
                        <Field description="Keep" name="State Form Line" size="1073741823" source="Summarize: GroupBy - State Form Line" type="V_WString" />
                        <Field description="Keep" name="Column Name" size="1073741823" source="Summarize: GroupBy - Column Name" type="V_WString" />
                        <Field description="Keep" name="Column Detail" size="1073741823" source="Summarize: GroupBy - Column Detail" type="V_WString" />
                        <Field description="Keep" name="Jurisdiction" size="255" source="File: C:\Users\pneilson\OneDrive - KPMG\Asset Management Platform - Project Spirit\Mapping Files\2025 Tax Year\Mapping File\2025_AK_Mapping.xlsx|||`2025 Mapping$`" type="V_String" />
                      </RecordInfo>
                    </MetaInfo>
                    <MetaInfo connection="False">
